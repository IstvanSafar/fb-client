<?xml version="1.0" encoding="utf-8"?>
<!-- The Java package is home.fbclient. The installed application id stays hu.otthon.fbkliens
     (build.sh: aapt2 rename-manifest-package option), because changing it would make Android treat
     this as a new app and the Facebook login would be lost. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="home.fbclient">

    <!-- The only permission. No contacts, location, camera, microphone, notifications or
         background work. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/AppTheme"
        android:allowBackup="false"
        android:usesCleartextTraffic="false">

        <!-- The WebView must not send URLs to Google Safe Browsing or collect metrics -->
        <meta-data android:name="android.webkit.WebView.EnableSafeBrowsing" android:value="false" />
        <meta-data android:name="android.webkit.WebView.MetricsOptOut" android:value="true" />

        <activity
            android:name="home.fbclient.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name="home.fbclient.SettingsActivity" android:exported="false"
            android:label="Settings" />
    </application>
</manifest>
